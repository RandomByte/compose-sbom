    {
      "id": 7,
      "type": "barchart",
      "title": "Open alerts per image: ${project}",
      "description": "Alerts of the latest scan per image. Grafana repeats this panel for every selected project.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "latest = from(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"sbom_scan\" and r._field == \"alerts\" and exists r.project and r.project == \"${project}\")\n  |> last()\n  |> map(fn: (r) => ({_value: string(v: r._time)}))\n  |> findColumn(fn: (key) => true, column: \"_value\")\n\nfrom(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"sbom_image\" and r._field == \"alerts\" and exists r.project and r.project == \"${project}\")\n  |> filter(fn: (r) => contains(value: string(v: r._time), set: latest))\n  |> group()\n  |> keep(columns: [\"image\", \"_value\"])\n  |> rename(columns: {_value: \"alerts\"})\n  |> sort(columns: [\"alerts\"], desc: true)"
        }
      ],
      "repeat": "project",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "decimals": 0,
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisGridShow": true
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "image",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "xTickLabelMaxLength": 28,
        "text": {
          "valueSize": 12
        },
        "xTickLabelRotation": 0,
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Images",
      "description": "Latest scan per image. Severity columns count distinct vulnerability IDs.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "latest = from(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"sbom_scan\" and r._field == \"alerts\" and exists r.project and r.project =~ /^${project:regex}$/)\n  |> group(columns: [\"project\"])\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({_value: r.project + \" \" + string(v: r._time)}))\n  |> findColumn(fn: (key) => true, column: \"_value\")\n\nfrom(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"sbom_image\" and exists r.project and r.project =~ /^${project:regex}$/)\n  |> filter(fn: (r) => contains(value: r.project + \" \" + string(v: r._time), set: latest))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"project\", \"image\", \"alerts\", \"kev\", \"critical\", \"high\", \"medium\", \"low\", \"eol_distro\"])\n  |> sort(columns: [\"kev\", \"alerts\", \"critical\"], desc: true)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "project": 0,
              "image": 1,
              "alerts": 2,
              "kev": 3,
              "critical": 4,
              "high": 5,
              "medium": 6,
              "low": 7,
              "eol_distro": 8
            },
            "renameByName": {
              "project": "Project",
              "image": "Image",
              "alerts": "Alerts",
              "kev": "KEV",
              "critical": "Critical",
              "high": "High",
              "medium": "Medium",
              "low": "Low",
              "eol_distro": "EOL distro"
            },
