      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sbom_scan\" and r._field == \"new_alerts\" and exists r.project and r.project =~ /^${project:regex}$/)\n  |> group(columns: [\"project\"])\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: true)\n  |> fill(usePrevious: true)\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n  |> sort(columns: [\"_time\"])"
        }
