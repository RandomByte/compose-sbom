    {
      "id": 6,
      "type": "stat",
      "title": "Latest scan",
      "description": "Time of the latest scan per project.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"sbom_scan\" and r._field == \"images\" and exists r.project and r.project =~ /^${project:regex}$/)\n  |> group(columns: [\"project\"])\n  |> last()\n  |> map(fn: (r) => ({r with _value: int(v: r._time) / 1000000}))\n  |> keep(columns: [\"project\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "decimals": 0,
          "color": {
