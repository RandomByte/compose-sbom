    {
      "id": 9,
      "type": "table",
      "title": "Open alerts",
      "description": "Alerts of the latest scan of each project: known exploited first, then end-of-life distributions, then by EPSS, the probability of exploitation in the next 30 days. Findings that the VEX document of a project marks as not affected are left out. The ID links to OSV.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "latest = from(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"sbom_scan\" and r._field == \"alerts\" and exists r.project and r.project =~ /^${project:regex}$/)\n  |> group(columns: [\"project\"])\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({_value: r.project + \" \" + string(v: r._time)}))\n  |> findColumn(fn: (key) => true, column: \"_value\")\n\nfrom(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"sbom_alert\" and exists r.project and r.project =~ /^${project:regex}$/)\n  |> filter(fn: (r) => contains(value: r.project + \" \" + string(v: r._time), set: latest))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({r with\n    epss: if exists r.epss then r.epss else 0.0,\n    prio: if r.kev then 2 else if r.severity == \"eol\" then 1 else 0,\n    sev: if r.severity == \"critical\" then 2 else if r.severity == \"high\" then 1 else 0,\n  }))\n  |> sort(columns: [\"prio\", \"epss\", \"sev\", \"project\", \"image\", \"id\"], desc: true)\n  |> keep(columns: [\"project\", \"image\", \"id\", \"severity\", \"kev\", \"epss\", \"packages\", \"versions\", \"fix\", \"aliases\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "project": 0,
              "image": 1,
              "id": 2,
              "severity": 3,
              "kev": 4,
              "epss": 5,
              "packages": 6,
              "versions": 7,
              "fix": 8,
              "aliases": 9
            },
            "renameByName": {
              "project": "Project",
              "image": "Image",
              "id": "ID",
              "severity": "Severity",
              "kev": "KEV",
              "epss": "EPSS",
              "packages": "Packages",
              "versions": "Versions",
              "fix": "Fixed in",
              "aliases": "Aliases"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "color": {
            "mode": "fixed",
