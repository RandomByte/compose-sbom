    {
      "id": 10,
      "type": "table",
      "title": "New alerts in the time range",
      "description": "Alerts at the scan that first reported them, newest first.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sbom_alert\" and exists r.project and r.project =~ /^${project:regex}$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.new)\n  |> group()\n  |> keep(columns: [\"_time\", \"project\", \"image\", \"id\", \"severity\", \"kev\", \"epss\", \"packages\", \"fix\"])\n  |> sort(columns: [\"_time\", \"epss\"], desc: true)"
        }
